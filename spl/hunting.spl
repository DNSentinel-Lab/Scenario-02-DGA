# Scenario 02 - DGA + High NXDOMAIN
# Detection Engineering hunting artifact

# HUNT 1 - 1-minute/client behavior summary
# ------------------------------------------
index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type="reply"
| eval qname_norm=lower(rtrim(qname,"."))
| eval qname_length=len(qname_norm)
| eval event_epoch=_time
| bin _time span=1m
| stats min(event_epoch) as first_event
        max(event_epoch) as last_event
        count as query_count
        dc(qname_norm) as unique_qnames
        count(eval(rcode="NXDOMAIN")) as nxdomain_count
        avg(qname_length) as avg_qname_length
        max(qname_length) as max_qname_length
        dc(qtype) as distinct_qtypes
        values(qtype) as qtypes
        values(rcode) as response_codes
        values(qname_norm) as qname_samples
    by _time client_ip
| eval unique_qname_ratio=round(unique_qnames/query_count,4)
| eval nxdomain_ratio=round(nxdomain_count/query_count,4)
| eval avg_qname_length=round(avg_qname_length,2)
| convert ctime(first_event) ctime(last_event)
| table _time first_event last_event client_ip query_count unique_qnames unique_qname_ratio nxdomain_count nxdomain_ratio avg_qname_length max_qname_length distinct_qtypes qtypes response_codes qname_samples
| sort 0 - query_count

# HUNT 2 - Raw DNS evidence pivot template
# ----------------------------------------
index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type="reply" client_ip="CLIENT_IP" earliest=EARLIEST_EPOCH latest=LATEST_EPOCH
| eval qname=lower(rtrim(qname,"."))
| table _time client_ip qname qtype rcode response_time cache_flag response_size
| sort 0 _time
