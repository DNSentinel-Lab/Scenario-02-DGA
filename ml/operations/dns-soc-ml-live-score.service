[Unit]
Description=DNS SOC Isolation Forest Live Scoring
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/dns-soc-ml/ml.env
ExecStart=/usr/local/sbin/dns-soc-ml-live-score
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dns-soc-ml-live
