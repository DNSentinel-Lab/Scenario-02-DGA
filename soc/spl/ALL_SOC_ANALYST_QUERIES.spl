# DNSentinel Scenario 02 — SOC Analyst SPL Query Collection
# Production Detection v1.0 thresholds were not changed.

# ===== 00_preflight_live_dns_15m.spl =====
index=dns_soc_dns
host="dns-soc-resolver01"
sourcetype="unbound:dns"
event_type="reply"
| stats count as reply_events
        min(_time) as first_event
        max(_time) as latest_event
| convert ctime(first_event) ctime(latest_event)

# ===== 01_detection_v1_live.spl =====
index=dns_soc_dns
host="dns-soc-resolver01"
sourcetype="unbound:dns"
event_type="reply"
| bin _time span=1m
| stats count as query_count
        dc(qname) as unique_qnames
        count(eval(rcode="NXDOMAIN")) as nxdomain_count
        values(qtype) as qtypes
        values(qname) as qname_samples
        by _time client_ip
| eval nxdomain_ratio=round(nxdomain_count/query_count,3)
| where query_count>=20 AND unique_qnames>=15 AND nxdomain_ratio>=0.75
| sort - _time

# ===== 02_detection_windows_clean.spl =====
index=dns_soc_dns
host="dns-soc-resolver01"
sourcetype="unbound:dns"
event_type="reply"
| bin _time span=1m
| stats count as query_count
        dc(qname) as unique_qnames
        count(eval(rcode="NXDOMAIN")) as nxdomain_count
        by _time client_ip
| eval nxdomain_ratio=round(nxdomain_count/query_count,3)
| where query_count>=20 AND unique_qnames>=15 AND nxdomain_ratio>=0.75
| table _time client_ip query_count unique_qnames nxdomain_count nxdomain_ratio
| sort _time

