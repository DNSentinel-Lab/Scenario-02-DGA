# ===== 05_qname_pattern_metrics.spl =====
index=dns_soc_dns
host="dns-soc-resolver01"
sourcetype="unbound:dns"
event_type="reply"
client_ip="10.50.30.20"
earliest="08/26/2026:06:37:00"
latest="08/26/2026:06:42:00"
| eval clean_qname=rtrim(qname,".")
| eval first_label=mvindex(split(clean_qname,"."),0)
| eval label_length=len(first_label)
| bin _time span=1m
| stats count as replies
        dc(qname) as unique_qnames
        avg(label_length) as avg_label_length
        min(label_length) as min_label_length
        max(label_length) as max_label_length
        values(qtype) as qtypes
        count(eval(rcode="NXDOMAIN")) as nxdomain_count
        by _time client_ip
| eval avg_label_length=round(avg_label_length,1)
| eval nxdomain_ratio=round(nxdomain_count/replies,3)
| table _time client_ip replies unique_qnames avg_label_length min_label_length max_label_length qtypes nxdomain_count nxdomain_ratio
| sort _time

# ===== 06_baseline_original_failed_test.spl =====
index=dns_soc_dns
host="dns-soc-resolver01"
sourcetype="unbound:dns"
event_type="reply"
client_ip="10.50.30.20"
earliest=-24h latest=now
| where _time < strptime("08/26/2026 06:37:00","%m/%d/%Y %H:%M:%S") OR _time >= strptime("08/26/2026 06:42:00","%m/%d/%Y %H:%M:%S")
| bin _time span=1m
| stats count as query_count dc(qname) as unique_qnames count(eval(rcode="NXDOMAIN")) as nxdomain_count by _time client_ip
| eval nxdomain_ratio=round(nxdomain_count/query_count,3)
| stats count as baseline_minutes
        round(avg(query_count),2) as avg_queries
        perc95(query_count) as p95_queries
        max(query_count) as max_queries
        round(avg(unique_qnames),2) as avg_unique_qnames
        perc95(unique_qnames) as p95_unique_qnames
        max(unique_qnames) as max_unique_qnames
        round(avg(nxdomain_ratio),3) as avg_nxdomain_ratio
        perc95(nxdomain_ratio) as p95_nxdomain_ratio
        max(nxdomain_ratio) as max_nxdomain_ratio

# Original failed test preserved for troubleshooting history.
# Splunk rejected round(avg(...),2) inside stats. See query 07.

# ===== 07_baseline_corrected.spl =====
index=dns_soc_dns
host="dns-soc-resolver01"
sourcetype="unbound:dns"
event_type="reply"
client_ip="10.50.30.20"
earliest=-24h latest=now
| where _time < strptime("08/26/2026 06:37:00","%m/%d/%Y %H:%M:%S") OR _time >= strptime("08/26/2026 06:42:00","%m/%d/%Y %H:%M:%S")
| bin _time span=1m
| stats count as query_count dc(qname) as unique_qnames count(eval(rcode="NXDOMAIN")) as nxdomain_count by _time client_ip
| eval nxdomain_ratio=nxdomain_count/query_count
| stats count as baseline_minutes
        avg(query_count) as avg_queries
        perc95(query_count) as p95_queries
        max(query_count) as max_queries
        avg(unique_qnames) as avg_unique_qnames
        perc95(unique_qnames) as p95_unique_qnames
        max(unique_qnames) as max_unique_qnames
        avg(nxdomain_ratio) as avg_nxdomain_ratio
        perc95(nxdomain_ratio) as p95_nxdomain_ratio
        max(nxdomain_ratio) as max_nxdomain_ratio
| eval avg_queries=round(avg_queries,2), avg_unique_qnames=round(avg_unique_qnames,2), avg_nxdomain_ratio=round(avg_nxdomain_ratio,3), p95_nxdomain_ratio=round(p95_nxdomain_ratio,3), max_nxdomain_ratio=round(max_nxdomain_ratio,3)

