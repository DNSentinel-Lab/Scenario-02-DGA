            "name": "Search_7",
            "options": {
                "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"reply\" client_ip=\"$client_ip_filter$\" qtype=\"$qtype_filter$\"\r\n| eval qname_norm=lower(rtrim(qname,\".\"))\r\n| eval qname_filter_value=lower(\"$qname_filter$\")\r\n| where qname_filter_value=\"*\" OR like(qname_norm,\"%\".qname_filter_value.\"%\")\r\n| timechart span=1m\r\n    count as \"DNS Replies\"\r\n    count(eval(rcode=\"NXDOMAIN\")) as \"NXDOMAIN Replies\""
            },
            "type": "ds.search"
        },
        "ds_MSUUdsad": {
            "name": "Search_11",
            "options": {
                "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"reply\" client_ip=\"$client_ip_filter$\" qtype=\"$qtype_filter$\" rcode=\"NXDOMAIN\"\r\n| eval qname_norm=lower(rtrim(qname,\".\"))\r\n| eval qname_filter_value=lower(\"$qname_filter$\")\r\n| where qname_filter_value=\"*\" OR like(qname_norm,\"%\".qname_filter_value.\"%\")\r\n| stats count as nxdomain_replies\r\n        values(qtype) as qtypes\r\n        min(_time) as first_seen\r\n        max(_time) as last_seen\r\n    by qname_norm\r\n| convert ctime(first_seen) ctime(last_seen)\r\n| sort - nxdomain_replies\r\n| head 15\r\n| rename qname_norm as \"Qname\",\r\n         nxdomain_replies as \"NXDOMAIN Replies\",\r\n         qtypes as \"Qtypes\",\r\n         first_seen as \"First Seen\",\r\n         last_seen as \"Last Seen\""
            },
            "type": "ds.search"
        },
        "ds_OHpamcmD": {
            "name": "Search_1",
            "options": {
                "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"reply\" client_ip=\"$client_ip_filter$\"  rcode=\"$rcode_filter$\" qtype=\"$qtype_filter$\"\r\n| eval qname_norm=lower(rtrim(qname,\".\"))\r\n| eval qname_filter_value=lower(\"$qname_filter$\")\r\n| where qname_filter_value=\"*\" OR like(qname_norm,\"%\".qname_filter_value.\"%\")\r\n| stats count as total_dns_replies"
            },
            "type": "ds.search"
        },
        "ds_TlD0d71D": {
            "name": "Search_12",
            "options": {
                "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"reply\" client_ip=\"$client_ip_filter$\" rcode=\"$rcode_filter$\" qtype=\"$qtype_filter$\"\r\n| eval qname_norm=lower(rtrim(qname,\".\"))\r\n| eval qname_filter_value=lower(\"$qname_filter$\")\r\n| where qname_filter_value=\"*\" OR like(qname_norm,\"%\".qname_filter_value.\"%\")\r\n| table _time client_ip qname_norm qtype rcode response_time cache_flag response_size\r\n| rename qname_norm as qname\r\n| sort - _time\r\n| head 100"
            },
            "type": "ds.search"
        },
        "ds_U7REA0jd": {
            "name": "Search_4",
            "options": {
                "query": "index=dns_soc_dns host=dns-soc-resolver01 sourcetype=unbound:dns event_type=\"reply\" client_ip=\"$client_ip_filter$\"  rcode=\"$rcode_filter$\" qtype=\"$qtype_filter$\"\r\n| eval qname_norm=lower(rtrim(qname,\".\"))\r\n| eval qname_filter_value=lower(\"$qname_filter$\")\r\n| where qname_filter_value=\"*\" OR like(qname_norm,\"%\".qname_filter_value.\"%\")\r\n| stats dc(qname_norm) as unique_qnames"
            },
